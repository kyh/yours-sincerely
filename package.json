{
  "name": "yours-sincerely",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "clean": "git clean -xdf node_modules",
    "clean:workspaces": "turbo run clean",
    "db:supabase": "pnpm -F db supabase",
    "db:start": "pnpm -F db start",
    "db:stop": "pnpm -F db stop",
    "db:reset": "pnpm -F db reset",
    "db:push": "pnpm -F db push",
    "db:push-remote": "pnpm -F db push:remote",
    "db:seed": "pnpm -F db seed",
    "dev": "turbo run dev --continue",
    "dev:web": "turbo run dev -F @repo/web",
    "dev:expo": "turbo run dev -F @repo/expo",
    "dev:mobile-ios": "pnpm -F mobile ios",
    "dev:mobile-android": "pnpm -F mobile android",
    "og:video": "pnpm -F @repo/web og:video",
    "lint": "oxlint --report-unused-disable-directives",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck typecheck:scripts",
    "typecheck:scripts": "tsc",
    "format": "oxfmt --check",
    "verify": "pnpm typecheck && pnpm lint && pnpm format && pnpm test && pnpm build",
    "lint:fix": "oxlint --fix",
    "format:fix": "oxfmt --write",
    "release:mobile:check": "dotenv -e .env -- node scripts/validate-mobile-release-env.ts",
    "release:mobile:check:eas": "dotenv -e .env -- node scripts/validate-mobile-release-env.ts --target eas",
    "release:mobile:check:web": "dotenv -e .env -- node scripts/validate-mobile-release-env.ts --target web"
  },
  "devDependencies": {
    "@interfere/landmines": "0.1.1",
    "@kyh/tsconfig": "catalog:",
    "@types/node": "catalog:",
    "dotenv-cli": "catalog:",
    "oxfmt": "^0.73.0",
    "oxlint": "^1.94.0",
    "oxlint-tsgolint": "^7.0.2008",
    "turbo": "^2.11.13",
    "typescript": "catalog:",
    "ultracite": "8.3.1",
    "zod": "catalog:"
  },
  "engines": {
    "node": "24.x"
  },
  "packageManager": "pnpm@12.3.4"
}
