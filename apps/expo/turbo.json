{
  "$schema": "https://turborepo.com/schema.json",
  "extends": ["//"],
  "tasks": {
    "dev": {
      "interactive": true,
      "passThroughEnv": ["$TURBO_EXTENDS$", "GOOGLE_SERVICES_JSON"]
    },
    "test": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/apps/web/src/app/styles/themes.css",
        "$TURBO_ROOT$/package.json"
      ]
    }
  }
}
