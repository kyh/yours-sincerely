{
  "extends": ["@kyh/tsconfig/base.json"],
  "compilerOptions": {
    "jsx": "react-native",
    "checkJs": false,
    "allowImportingTsExtensions": true,
    "moduleSuffixes": [".ios", ".android", ".native", ""],
    // The *.test.ts suites run under node, and @repo/contracts uses `TextEncoder`.
    // TS 6 loads no @types package unless named; these used to arrive by
    // accident, through the @repo/api source this app no longer imports.
    "types": ["node"],
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["src", "*.ts", "*.js", ".expo/types/**/*.ts", "expo-env.d.ts", "nativewind-env.d.ts"],
  "exclude": ["node_modules"]
}
