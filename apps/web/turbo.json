{
  "$schema": "https://turborepo.org/schema.json",
  "extends": ["//"],
  "tasks": {
    "build": {
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/.env", "$TURBO_ROOT$/.env.local"],
      "outputs": [".next/**", "!.next/cache/**", "!.next/dev/**", "next-env.d.ts"]
    },
    "dev": {
      "passThroughEnv": [
        "$TURBO_EXTENDS$",
        "COOKIE_SECRET",
        "COOKIE_SECRET_LEGACY",
        "POSTGRES_URL",
        "RESEND_API_KEY",
        "RESET_LINK_ORIGIN"
      ]
    }
  }
}
