{
  "$schema": "https://turborepo.org/schema.json",
  "ui": "tui",
  "cacheMaxSize": "2GB",
  "tasks": {
    "topo": {
      "dependsOn": ["^topo"]
    },
    "build": {
      "dependsOn": ["^topo"],
      "env": [
        "COOKIE_SECRET",
        "COOKIE_SECRET_LEGACY",
        "POSTGRES_URL",
        "RESEND_API_KEY",
        "RESET_LINK_ORIGIN"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "passThroughEnv": ["PORT"]
    },
    "typecheck": {
      "dependsOn": ["^topo"],
      "outputs": [".cache/tsbuildinfo.json"]
    },
    "test": {
      "dependsOn": ["^topo"],
      "outputs": []
    },
    "clean": {
      "cache": false
    },
    "//#clean": {
      "cache": false
    }
  },
  "globalPassThroughEnv": [
    "NODE_ENV",
    "CI",
    "VERCEL",
    "VERCEL_ENV",
    "VERCEL_URL",
    "npm_lifecycle_event"
  ]
}
